    document.getElementById('btn-auth').addEventListener('click', async function (e) {
        e.preventDefault();

        try {
            const logout = await fetch('admin/logout', {
                'method': 'GET',
            })
        } catch (e) {
            alert(e)
        }
    })

</script>
</html>